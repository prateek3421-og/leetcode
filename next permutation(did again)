class Solution {
   void swap(int[] arr, int i, int j) {
    int temp = arr[i];
    arr[i] = arr[j];
    arr[j] = temp;
}
public void reverseArray(int[] arr) {
    rev(arr, 0, arr.length - 1);
}
    
    public void rev(int[] arr,int l,int r){
        int left = l;
        int right= r;
        while (left<right){
            int temp=arr[left];
            arr[left]=arr[right];
            arr[right]=temp;
            left++;
            right--;
        }
    }
    public void nextPermutation(int[] nums) {
       int j=-1; 
        int n = nums.length;
        int pivot=0;
        
        for(int i =n-2;i>=0;i--){
            if(nums[i]<nums[i+1]){
                pivot=i;
                j=1;
                break;
            }
        }
        for(int i =n-1;i>pivot;i--){
            if(nums[i]>nums[pivot]){
                swap(nums,i,pivot);
                break;
            }
        }
        
       if(j==1){ 
        rev(nums,pivot+1,n-1);
       }else{
        reverseArray(nums);
       }
        
    }
}
