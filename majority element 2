class Solution {
    public List<Integer> majorityElement(int[] nums) {
        int candidate1=0;
        int candidate2=0;
        int count1=0;
        int count2=0;
        int n =nums.length;
        for(int i=0;i<n;i++){
            int num=nums[i];
            if(count1>0&&num==candidate1){
                count1++;
            }
            else if(count2>0&&num==candidate2){
                count2++;
            }
            else if(count1==0){
                candidate1=num;
                count1=1;
            }
            else if(count2==0){
                candidate2=num;
                count2=1;
            }
            else{
                count1--;
                count2--;
            }

        }
        int least=n/3;
        int check1=0;
        int check2=0;

        for(int i =0;i<n;i++){
            if(nums[i]==candidate1){
                check1++;
            }
            else if(nums[i]==candidate2){
                check2++;
            }          
        }
        List <Integer> answer= new ArrayList<>();
         if(check1>least){
            answer.add(candidate1);
         }
         if(check2>least){
            answer.add(candidate2);
         }
        return answer;
    }
}
